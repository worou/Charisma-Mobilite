DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=charisma_move
PORT=3001

# Connexion Google / GitHub (OAuth)
# Callbacks à déclarer : http://localhost:3000/api/auth/google/callback
#                        http://localhost:3000/api/auth/github/callback
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Emails de notification (bus complet). Sans SMTP_HOST, notification dans le site uniquement.
# SendGrid : SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<clé API>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Itinéraires en transports en commun vers l'Église (onglet Train)
# Clé gratuite : créer un compte sur https://prim.iledefrance-mobilites.fr puis générer un jeton
PRIM_API_KEY=
CHURCH_NAME=Église Charisma
CHURCH_ADDRESS=
