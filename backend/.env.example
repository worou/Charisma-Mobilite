# Base MySQL / MariaDB
# En local : base de développement o2switch via le tunnel SSH (npm run db:tunnel), port 3307
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=
# Compte SSH utilisé par npm run db:tunnel
SSH_TUNNEL_USER=
SSH_TUNNEL_HOST=
PORT=3001

# Connexion Google / GitHub (OAuth)
# Callbacks à déclarer : http://localhost:3000/api/auth/google/callback
#                        http://localhost:3000/api/auth/github/callback
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Emails de notification (bus complet). Sans SMTP_HOST, notification dans le site uniquement.
# SendGrid : SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<clé API>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Itinéraires en transports en commun vers l'Église (onglet Train)
# Clé gratuite : créer un compte sur https://prim.iledefrance-mobilites.fr puis générer un jeton
PRIM_API_KEY=
CHURCH_NAME=Église Charisma
CHURCH_ADDRESS=

# URL publique de l API si elle est sur un autre domaine que le site (callbacks OAuth)
API_PUBLIC_URL=

